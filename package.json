{
    "name": "empty",
    "version": "0.0.0",
    "description": "POS system",
    "author": "Mazen",
    "private": true,
    "type": "module",
    "main": "main.js",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite --host",
        "build": "vite build",
        "preview": "vite preview --host",
        "clean": "node -e \"['dist', 'dist_electron'].forEach(d => { if(fs.existsSync(d)) { const tmp = d + '_old_' + Date.now(); try { fs.renameSync(d, tmp); fs.rmSync(tmp, {recursive:true, force:true, maxRetries:10}); } catch(e) { try { fs.rmSync(d, {recursive:true, force:true, maxRetries:10}); } catch(err){} } } })\"",
        "build:api": "cd ../../backend/POS/POS && dotnet publish -c Release -r win-x64 --self-contained true -p:DebugType=None -p:DebugSymbols=false -o ./publish",
        "build:vue": "vite build --mode production",
        "build:electron": "node --max-old-space-size=8192 ./node_modules/electron-builder/out/cli/cli.js",
        "build:all": "npm run clean && npm run build:api && npm run build:vue && npm run build:electron",
        "electron": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
        "electron-build": "npm run build:all"
    },
    "build": {
        "appId": "com.pos.standalone",
        "productName": "POS",
        "electronDist": "node_modules/electron/dist",
        "directories": {
            "output": "dist_electron"
        },
        "files": [
            "dist/**/*",
            "public/**/*",
            "main.js",
            "package.json",
            "!node_modules/**/*"
        ],
        "extraResources": [
            {
                "from": "../../backend/POS/POS/publish",
                "to": "api",
                "filter": [
                    "**/*",
                    "!*.pdb",
                    "!**/*.pdb"
                ]
            },
            {
                "from": "../../backend/POS/POS/install_db.bat",
                "to": "install_db.bat"
            }
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": true,
            "differentialPackage": false,
            "include": "build/installer.nsh"
        }
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "@vueuse/core": "^13.9.0",
        "@vueuse/integrations": "^13.9.0",
        "axios": "^1.12.2",
        "chart.js": "^4.5.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "date-fns-tz": "^3.2.0",
        "js-sha256": "^0.11.1",
        "keycloak-js": "^26.2.3",
        "lucide-vue-next": "^0.563.0",
        "pinia": "^3.0.4",
        "primevue": "^4.5.4",
        "qrcode": "^1.5.4",
        "tailwind-merge": "^3.4.0",
        "tailwindcss": "^4.1.11",
        "tailwindcss-primeui": "^0.6.1",
        "vee-validate": "^4.15.1",
        "vue": "^3.5.24",
        "vue-advanced-cropper": "^2.8.9",
        "vue-cal": "^5.0.1-rc.34",
        "vue-chartjs": "^5.3.3",
        "vue-router": "^4.6.3",
        "vuedraggable": "^4.1.0",
        "yup": "^1.7.0"
    },
    "devDependencies": {
        "@originjs/vite-plugin-federation": "^1.4.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "concurrently": "^10.0.4",
        "electron": "^43.2.0",
        "electron-builder": "^26.15.3",
        "eslint": "^9.33.0",
        "eslint-plugin-vue": "^10.4.0",
        "tw-animate-css": "^1.4.0",
        "unplugin-auto-import": "^20.0.0",
        "unplugin-vue-components": "^29.0.0",
        "vite": "^7.1.11",
        "vite-plugin-vue-devtools": "^8.0.0",
        "wait-on": "^9.1.0"
    }
}
